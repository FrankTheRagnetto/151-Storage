<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO build di debug: il server WebDAV di prova sul PC, visto dall'emulatore come 10.0.2.2.
     Non esiste altrove (non e' un indirizzo di casa ne' di internet). Tutto il resto resta solo https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- il server video sul telefono stesso (LocalStream), come nella build normale -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
