<?xml version="1.0" encoding="utf-8"?>
<!-- il visore che si chiude: sfuma e si ritira un poco verso il centro, 180 ms -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:shareInterpolator="true"
    android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="180" />
    <scale android:fromXScale="1" android:toXScale="0.95" android:fromYScale="1" android:toYScale="0.95"
        android:pivotX="50%" android:pivotY="50%" android:duration="180" />
</set>
