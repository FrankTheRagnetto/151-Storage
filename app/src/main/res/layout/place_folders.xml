<?xml version="1.0" encoding="utf-8"?>
<!-- Cartelle (spec §7): linguette come il Cloud, lastra kraft, foglio con cartelle e file -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/placeFolders"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <HorizontalScrollView
        android:id="@+id/fdCrumbStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="28dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/fdCrumbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/fdBoard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/place_folder"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/fdStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="9dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Viewer.Meta" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/panel_leaf">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fdList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/fdEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/folder_empty"
                android:textAppearance="@style/TextAppearance.Viewer.Prose"
                android:textColor="@color/ink_muted"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
