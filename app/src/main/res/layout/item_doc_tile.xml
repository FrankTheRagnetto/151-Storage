<?xml version="1.0" encoding="utf-8"?>
<!-- un documento nella vista a griglia: il bollino grande col tipo, sotto il nome -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/row_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.the151universe.storage.SquareFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Viewer.Badge" />
        </com.the151universe.storage.SquareFrame>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Viewer.Meta"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Viewer.Meta"
        android:textColor="@color/ink_muted" />
</LinearLayout>
