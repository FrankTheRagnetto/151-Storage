<?xml version="1.0" encoding="utf-8"?>
<!-- una cella della griglia (spec §4): miniatura quadrata, durata dei video, segno «nel cloud», casella in selezione -->
<com.the151universe.storage.SquareFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1.5dp"
    android:background="@color/row_selected">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/acetate_sunk"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/scrim_label"
        android:drawablePadding="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textAppearance="@style/TextAppearance.Viewer.Badge"
        android:textColor="@color/on_scrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/cloudMark"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/cloud_mark"
        android:visibility="gone">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cloud_done"
            app:tint="@color/on_hue_dark" />
    </FrameLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="5dp"
        android:importantForAccessibility="no"
        android:padding="3dp"
        android:visibility="gone" />
</com.the151universe.storage.SquareFrame>
