<?xml version="1.0" encoding="utf-8"?>
<!-- Foto (spec §4): striscia attrezzi (Tutto | Foto | Video, linguette album), lastra ottanio, foglio con la griglia -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/placePhotos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/phTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/acetate"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/phKind"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabGravity="fill"
            app:tabMode="fixed" />

        <HorizontalScrollView
            android:id="@+id/phAlbumStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:fadingEdgeLength="28dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/phAlbums"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                app:chipSpacingHorizontal="3dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/phBoard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/place_photo"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/phStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="9dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Viewer.Meta" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/panel_leaf">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/phGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="2.5dp"
                android:paddingBottom="24dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/phEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:textAppearance="@style/TextAppearance.Viewer.Prose"
                android:textColor="@color/ink_muted"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
