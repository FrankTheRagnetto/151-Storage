<?xml version="1.0" encoding="utf-8"?>
<!-- invito all'accesso, comune a Foto e Cartelle (come libInvite di Documenti) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/accessInvite"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/slip"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/inviteIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_photos" />

            <TextView
                android:id="@+id/inviteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:breakStrategy="balanced"
                android:textAppearance="@style/TextAppearance.Viewer.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/access_why"
                android:textAppearance="@style/TextAppearance.Viewer.Prose" />

            <Button
                android:id="@+id/inviteGrant"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/grant_access" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
