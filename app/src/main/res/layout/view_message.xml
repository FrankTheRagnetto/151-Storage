<?xml version="1.0" encoding="utf-8"?>
<!-- Il foglietto: formato che non si apre, foto o video, errore di lettura.
     Bollino della sezione con l'estensione, titolo, nome e misure, la spiegazione in Garamond, cosa fare.
     Per un errore vero il foglietto diventa «errata»: fondo e filo vermiglio (ViewerActivity.showMessage). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/board"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <LinearLayout
            android:id="@+id/msgSlip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/slip"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/msgBadge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Viewer.Badge"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/msgTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:breakStrategy="balanced"
                android:textAppearance="@style/TextAppearance.Viewer.Headline"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/msgName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.Viewer.Body"
                android:textColor="@color/ink"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/msgMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/TextAppearance.Viewer.Meta"
                android:textColor="@color/ink_muted"
                android:textIsSelectable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/seam" />

            <TextView
                android:id="@+id/msgBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.Viewer.Prose"
                android:textColor="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/msgPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/open_with"
                app:icon="@drawable/ic_open_with"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/msgSecondary"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/show_as_text" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
