<?xml version="1.0" encoding="utf-8"?>
<!-- recente: stessa grammatica della riga della libreria -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/badge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Viewer.Badge" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Viewer.Body"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Viewer.Meta"
            android:textColor="@color/ink_muted" />
    </LinearLayout>
</LinearLayout>
