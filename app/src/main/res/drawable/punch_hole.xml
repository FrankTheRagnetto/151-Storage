<?xml version="1.0" encoding="utf-8"?>
<!-- il foro della perforatrice: segna la linguetta scelta (attraverso si vede l'acetato) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="10dp" android:height="10dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/acetate" />
            <stroke android:width="1dp" android:color="#59000000" />
        </shape>
    </item>
</layer-list>
